rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isEmployer() {
      return signedIn() && userProfile(request.auth.uid).role == "employer";
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ["student", "employer"];
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /internships/{internshipId} {
      allow read: if signedIn();
      allow create: if isEmployer()
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isEmployer()
        && resource.data.employerId == request.auth.uid
        && request.resource.data.employerId == resource.data.employerId;
      allow delete: if isEmployer()
        && resource.data.employerId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && userProfile(request.auth.uid).role == "student"
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == "pending"
        && get(/databases/$(database)/documents/internships/$(request.resource.data.jobId)).data.employerId == request.resource.data.employerId
        && get(/databases/$(database)/documents/internships/$(request.resource.data.jobId)).data.isActive == true;
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.employerId == request.auth.uid);
      allow update: if isEmployer()
        && resource.data.employerId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["pending", "under review", "interview", "accepted", "rejected"];
      allow delete: if false;
    }
  }
}
